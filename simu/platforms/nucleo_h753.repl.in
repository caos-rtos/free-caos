// NUCLEO-H753ZI (MB1364) on top of Renode's stm32h753 model.
// Console: USART3 (UART_DBG_NUM=3, PD8/PD9 -> ST-LINK VCP).
using "stm32h753_caos.repl"   // simu/gen_platforms.py

// Fewer virtual MIPS = more virtual time per instruction: polled waits on
// SysTick (EN_STLINK_WAIT_READY, 3 s pre-scheduler) end in seconds, not minutes.
cpu:
    cpuType: "cortex-m7"
    PerformanceInMips: 20

// Holes of the memory map: an access is a BusFault, as on silicon (busfault_hole.py).
hole_flash: Python.PythonPeripheral @ sysbus 0x08200000
    size: 0x17D00000
    initable: true
    script: '''
@inline(busfault_hole.py)
'''

hole_ram: Python.PythonPeripheral @ sysbus 0x24080000
    size: 0x0BF80000
    initable: true
    script: '''
@inline(busfault_hole.py)
'''
