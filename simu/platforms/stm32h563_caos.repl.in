// STM32H563 (RM0481), written for caOS on Renode: Renode has no STM32H5 model.
// Non-secure aliases only (TZEN=0, the caOS images link at 0x08000000/0x20000000).
// @inline(file) is replaced by simu/gen_platforms.py with the stub's source.

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 250000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

// Engineering bytes: TS_CAL/VREFINT_CAL at 0x08FFF81x (written by
// nucleo_h563.resc, 0 in Renode).
sysmem: Memory.MappedMemory @ sysbus 0x08FFF000
    size: 0x1000

// SRAM1 256K + SRAM2 64K + SRAM3 320K, contiguous
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xA0000

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 250000000

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 250000000
    IRQ -> nvic@60

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    numberOfAFs: 16

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    numberOfAFs: 16

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    numberOfAFs: 16

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x42020C00, +0x400>
    numberOfAFs: 16

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>
    numberOfAFs: 16

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>
    numberOfAFs: 16

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    numberOfAFs: 16

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    numberOfAFs: 16

gpioPortI: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>
    numberOfAFs: 16

rcc: Python.PythonPeripheral @ sysbus 0x44020C00
    size: 0x400
    initable: true
    script: '''
@inline(h5_rcc_stub.py)
'''

pwr: Python.PythonPeripheral @ sysbus 0x44020800
    size: 0x400
    initable: true
    script: '''
@inline(h5_pwr_stub.py)
'''

flash_regs: Python.PythonPeripheral @ sysbus 0x40022000
    size: 0x400
    initable: true
    script: '''
@inline(regfile_stub.py)
'''

icache: Python.PythonPeripheral @ sysbus 0x40030400
    size: 0x400
    initable: true
    script: '''
@inline(cache_stub.py)
'''

dcache1: Python.PythonPeripheral @ sysbus 0x40031400
    size: 0x400
    initable: true
    script: '''
@inline(cache_stub.py)
'''

// ADC1 (+ ADC12 common at +0x300): register stub, same layout as H7.
adc1: Python.PythonPeripheral @ sysbus 0x42028000
    size: 0x400
    initable: true
    script: '''
@inline(adc_stub.py)
'''

// RNG: register stub on the host's /dev/urandom (rng_stub.py).
rng: Python.PythonPeripheral @ sysbus 0x420C0800
    size: 0x400
    initable: true
    script: '''
@inline(rng_stub.py)
'''

// DTS: register stub (see h5_dts_stub.py): without it the boot polls 4M times.
dts: Python.PythonPeripheral @ sysbus 0x40008C00
    size: 0x400
    initable: true
    script: '''
@inline(h5_dts_stub.py)
'''

// Timers (CMSIS bases/IRQs; TIM1/TIM8 on their update IRQ). Kernel clock
// 250 MHz as caOS sets the APB prescalers; TIM2-5 are 32 bit.
timer1: Timers.STM32_Timer @ sysbus 0x40012C00
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@42

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 250000000
    initialLimit: 0xFFFFFFFF
    -> nvic@45

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    frequency: 250000000
    initialLimit: 0xFFFFFFFF
    -> nvic@46

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    frequency: 250000000
    initialLimit: 0xFFFFFFFF
    -> nvic@47

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    frequency: 250000000
    initialLimit: 0xFFFFFFFF
    -> nvic@48

timer6: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@49

timer7: Timers.STM32_Timer @ sysbus 0x40001400
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@50

timer8: Timers.STM32_Timer @ sysbus 0x40013400
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@66

timer15: Timers.STM32_Timer @ sysbus 0x40014000
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@71

timer16: Timers.STM32_Timer @ sysbus 0x40014400
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@72

timer17: Timers.STM32_Timer @ sysbus 0x40014800
    frequency: 250000000
    initialLimit: 0xFFFF
    -> nvic@73

// IWDG (LSI 32 kHz): Renode's STM32 model, so `reboot` (watchdog armed, feed
// stopped) restarts the board instead of hanging (simu/CHANGES.md 29).
iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000
    windowOption: true
    defaultPrescaler: 0x4
